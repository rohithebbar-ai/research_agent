# ---- Azure OpenAI (default LLM provider) ----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# The deployment NAME (not the model name) of your chat model
AZURE_OPENAI_CHAT_DEPLOYMENT=
# Optional, not used by the current agents
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ---- Cosmos DB ----
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=

# ---- Tavily web search (required by Scout) ----
TAVILY_API_KEY=

# ---- LLM provider: azure (default) or nvidia ----
LLM_PROVIDER=azure
# Only used when LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

# ---- Scout tuning (optional) ----
# Runs pause while this many ideas are still waiting for a decision
SCOUT_BACKLOG_CAP=8

# ---- WhatsApp Cloud API (optional, placeholder scaffolding) ----
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
